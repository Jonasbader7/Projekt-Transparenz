# CC0 structured statements; no completeness claim.
# SIX Swiss Exchange = Q661834 (the previous Q12569 was wrong: that QID is the Loire river).
# Item set restricted to "has an ISIN and a Swiss country claim" or "listed on SIX" so the
# live query service answers in seconds; the old P17=Switzerland + transitive
# instance-of/subclass-of(enterprise) scan over all of Wikidata timed out (and, with the
# wrong SIX QID, found zero listings besides). No inferred issuer mapping from a
# company-level ISIN.
SELECT DISTINCT ?item ?labelDe ?labelEn ?isin ?lei ?exchange ?ticker ?tickerQ ?country ?parent
                ?instanceOf WHERE {
  {
    SELECT DISTINCT ?item WHERE {
      { ?item wdt:P946 ?anyIsin . ?item wdt:P17 wd:Q39 . }
      UNION { ?item wdt:P414 wd:Q661834 . }
    }
  }
  OPTIONAL { ?item wdt:P946 ?isin }
  OPTIONAL { ?item wdt:P1278 ?lei }
  OPTIONAL { ?item wdt:P414 ?exchange }
  OPTIONAL { ?item wdt:P249 ?ticker }
  # Ticker symbol is often a qualifier of the "stock exchange" statement, not a
  # standalone claim (seen live: Roche's P414=SIX statement carries P249=ROG as a
  # qualifier, with no top-level P249 statement at all).
  OPTIONAL { ?item p:P414 ?exchangeStmt . OPTIONAL { ?exchangeStmt pq:P249 ?tickerQ } }
  OPTIONAL { ?item wdt:P17 ?country }
  OPTIONAL { ?item wdt:P749 ?parent }
  OPTIONAL { ?item wdt:P31 ?instanceOf }
  OPTIONAL { ?item rdfs:label ?labelDe . FILTER(LANG(?labelDe) = "de") }
  OPTIONAL { ?item rdfs:label ?labelEn . FILTER(LANG(?labelEn) = "en") }
}
