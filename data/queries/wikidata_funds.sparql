# Separate fund catalogue candidates. Never holdings.
SELECT DISTINCT ?item ?itemLabel ?property ?value WHERE {
  {
    SELECT DISTINCT ?item WHERE {
      { ?item wdt:P17 wd:Q39 }
      UNION { ?item wdt:P159/wdt:P17 wd:Q39 }
      UNION { ?item wdt:P414 wd:Q12569 }
      VALUES ?fundClass { wd:Q927783 wd:Q756898 }
      ?item wdt:P31/wdt:P279* ?fundClass .
    }
  }
  VALUES ?property {wdt:P17 wdt:P159 wdt:P1278 wdt:P946 wdt:P414 wdt:P249 wdt:P31}
  ?item ?property ?value .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "de,en,fr,it" }
}
ORDER BY ?item ?property ?value
