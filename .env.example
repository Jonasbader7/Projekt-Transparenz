# Kopieren nach .env und anpassen. .env wird nie committet.

# Anzeigename des Produkts (einzige Stelle, an der er überschrieben werden kann)
TRANSPARENZ_DISPLAY_NAME="Projekt Transparenz"

# Datenbank (Standard: SQLite im Ordner data/processed)
# Später z. B.: postgresql+psycopg://user:pass@host:5432/transparenz
TRANSPARENZ_DATABASE_URL=

# Log-Level: DEBUG, INFO, WARNING, ERROR
TRANSPARENZ_LOG_LEVEL=INFO

# Kontakt-Angabe für HTTP-Abrufe (z. B. SEC EDGAR verlangt einen aussagekräftigen User-Agent).
# Erst ausfüllen, wenn echte Quellen angebunden werden.
TRANSPARENZ_HTTP_USER_AGENT=

# market-update: eigene Kontakt-E-Mail für den SEC-HTTP-User-Agent, bleibt lokal.
TRANSPARENZ_SEC_CONTACT=
